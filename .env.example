# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Used by the daily cron (keepalive + price refresh) to write reference
# tables (instruments, prices). Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Daily cron auth. Vercel auto-provisions this and sends `Authorization: Bearer <value>`.
# Set it locally only to test /api/cron/daily by hand.
CRON_SECRET=

# LLM provider keys (server-only). Presence = the provider shows "connected" on /settings.
# AI category-suggest (description text only — never amounts/dates/balances) is wired for
# gemini and openai only. anthropic/openrouter are listed in the provider catalog but have
# no adapter yet, so picking either as active on /settings will surface a clear "not
# available" error instead of a suggestion — set GEMINI_API_KEY or OPENAI_API_KEY below and
# select that provider on /settings.
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Optional: override the default model for the wired providers.
GEMINI_MODEL=
OPENAI_MODEL=

# Optional: log the exact AI-suggest prompt (description text only) to server stdout for debugging.
DEBUG_AI_SUGGEST=
